# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────

# Port the web server listens on.
UI_PORT=8080

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# Data paths
# ─────────────────────────────────────────────

# Directory where downloaded trace JSON files are cached.
TRACES_BASE_PATH=data/traces

# Directory where exported artifacts (agents, tools, etc.) are saved.
ARTIFACTS_BASE_PATH=data/artifacts

# File used to persist conversation contexts for the Ask page.
CONTEXTS_FILE=data/contexts.json

# Directory where interaction logs are stored.
INTERACTIONS_BASE_PATH=data/interactions

# Maximum number of interactions to retain per context.
MAX_INTERACTIONS=50

# ─────────────────────────────────────────────
# Ask page
# ─────────────────────────────────────────────

# Seconds to wait after submitting a query before polling for a trace result.
ASK_TRACE_DELAY_SECONDS=5